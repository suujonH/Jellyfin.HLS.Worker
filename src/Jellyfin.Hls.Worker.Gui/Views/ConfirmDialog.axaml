<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Jellyfin.Hls.Worker.Gui.Views.ConfirmDialog"
        Title="确认"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button x:Name="AcceptButton" Classes="accent" Click="OnAcceptClick" IsDefault="True" />
            <Button x:Name="CancelButton" Click="OnCancelClick" IsCancel="True" />
        </StackPanel>
        <SelectableTextBlock x:Name="Message" TextWrapping="Wrap" />
    </DockPanel>
</Window>
